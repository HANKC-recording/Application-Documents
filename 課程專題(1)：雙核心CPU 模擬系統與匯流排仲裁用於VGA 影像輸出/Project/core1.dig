          <string>clk,rst,instr:16,alu_result:8,alu_flagZ,rf_dataA:8,rf_dataB:8,vram_wr_gnt</string>
        </entry>
        <entry>
          <string>Width</string>
          <int>12</int>
        </entry>
        <entry>
          <string>Code</string>
          <string>// =================================================================
// control_unit.v  —  FSM Control Unit（16x16 版）
// =================================================================
module control_unit (
    input        clk,
    input        rst,
    output reg [7:0] pc,
    input      [15:0] instr,
    output reg [3:0] alu_op,
    output reg [7:0] alu_op1,
    output reg [7:0] alu_op2,
    input      [7:0] alu_result,
    input            alu_flagZ,
    output reg [1:0] rf_rd_addrA,
    output reg [1:0] rf_rd_addrB,
    input      [7:0] rf_dataA,
    input      [7:0] rf_dataB,
    output reg       rf_wr_en,
    output reg [1:0] rf_wr_addr,
    output reg [7:0] rf_wr_data,
    output reg       vram_wr_req,
    input            vram_wr_gnt,
    output reg [7:0] vram_addr,
    output reg [2:0] vram_data,
    output reg [3:0] cur_opcode,
    output reg [1:0] cur_state
);
    localparam [1:0] S_FETCH=2&apos;b00, S_DECODE=2&apos;b01, S_EXECUTE=2&apos;b10, S_WRITEBACK=2&apos;b11;
    localparam [3:0]
        OP_MOV=4&apos;b0000, OP_ADD=4&apos;b0001, OP_SUB=4&apos;b0010,
        OP_AND=4&apos;b0011, OP_OR =4&apos;b0100, OP_OUT=4&apos;b0101,
        OP_BEQ=4&apos;b0110, OP_JMP=4&apos;b0111;
    reg [15:0] IR;
    wire [3:0] ir_opcode = IR[15:12];
    wire [1:0] ir_rd     = IR[11:10];
    wire [1:0] ir_rs     = IR[9:8];
    wire [7:0] ir_imm8   = IR[7:0];
    reg [1:0] state;
    always @(posedge clk) begin
        if (rst) begin
            state &lt;= S_FETCH; pc &lt;= 8&apos;h00;
            IR &lt;= 16&apos;h0000; rf_wr_en &lt;= 0; vram_wr_req &lt;= 0;
        end else begin
            cur_state &lt;= state;
            case (state)
                S_FETCH: begin
                    IR &lt;= instr; rf_wr_en &lt;= 0; vram_wr_req &lt;= 0;
                    state &lt;= S_DECODE;
                end
                S_DECODE: begin
                    cur_opcode  &lt;= ir_opcode;
                    rf_rd_addrA &lt;= ir_rd;
                    rf_rd_addrB &lt;= ir_rs;
                    alu_op      &lt;= ir_opcode;
                    state       &lt;= S_EXECUTE;
                end
                S_EXECUTE: begin
                    alu_op1 &lt;= rf_dataA;
                    alu_op2 &lt;= (ir_opcode==OP_MOV||ir_opcode==OP_BEQ||ir_opcode==OP_JMP)
                               ? ir_imm8 : rf_dataB;
                    if (ir_opcode == OP_OUT) begin
                        vram_addr   &lt;= ir_imm8;
                        vram_data   &lt;= rf_dataB[2:0];
                        vram_wr_req &lt;= 1;
                    end
                    state &lt;= S_WRITEBACK;
                end
                S_WRITEBACK: begin
                    vram_wr_req &lt;= 0;
                    case (ir_opcode)
                        OP_MOV, OP_ADD, OP_SUB, OP_AND, OP_OR: begin
                            rf_wr_en &lt;= 1; rf_wr_addr &lt;= ir_rd;
                            rf_wr_data &lt;= alu_result; pc &lt;= pc + 8&apos;h01;
                        end
                        OP_OUT: begin
                            rf_wr_en &lt;= 0;
                            if (vram_wr_gnt) pc &lt;= pc + 8&apos;h01;
                            else begin vram_wr_req &lt;= 1; state &lt;= S_WRITEBACK; end
                        end
                        OP_BEQ: begin
                            rf_wr_en &lt;= 0;
                            pc &lt;= alu_flagZ ? ir_imm8 : (pc + 8&apos;h01);
                        end
                        OP_JMP: begin rf_wr_en &lt;= 0; pc &lt;= ir_imm8; end
                        default: begin rf_wr_en &lt;= 0; pc &lt;= pc + 8&apos;h01; end
                    endcase
                    if (ir_opcode != OP_OUT || vram_wr_gnt) state &lt;= S_FETCH;
                end
            endcase
        end
    end
endmodule</string>
        </entry>
