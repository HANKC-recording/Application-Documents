        <entry>
          <string>Code</string>
          <string>// prog_rom_c1.v - Core 1: row 8~15
// key = {img_sel[1:0], pc[7:0]} = 10-bit
// 每像素2條: MOV R0,color + OUT R0-&gt;VRAM[addr]
// OUT格式: op=0101 Rd=00 Rs=00 imm8=vram_addr
//   control_unit: vram_addr=imm8, vram_data=rf_dataB(=R0)

module prog_rom_c1 (
    input  [7:0] pc,
    input  [1:0] img_sel,
    output reg [15:0] instr
);
    wire [9:0] key = {img_sel, pc};
    always @(*) begin
        case (key)
            // ==== Image 0 ====
            10&apos;d0: instr = 16&apos;b0000_00_00_00000000;
            10&apos;d1: instr = 16&apos;b0101_00_00_10000000;
            10&apos;d2: instr = 16&apos;b0000_00_00_00000000;
            10&apos;d3: instr = 16&apos;b0101_00_00_10000001;
            10&apos;d4: instr = 16&apos;b0000_00_00_00000000;
