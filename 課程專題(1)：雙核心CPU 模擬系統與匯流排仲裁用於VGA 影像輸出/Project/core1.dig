          <string>Width</string>
          <int>9</int>
        </entry>
        <entry>
          <string>Code</string>
          <string>// =================================================================
// reg_file.v  —  Register File for Dual-Core CPU
//
// 4 個 8-bit 暫存器 R0–R3
// 2 個非同步讀取 port（combinational）
// 1 個同步寫入 port（posedge clk，有 wr_en 控制）
// rst 高電位同步清零
// =================================================================

module reg_file (
    input            clk,
    input            rst,
    // 寫入 port
    input            wr_en,
    input      [1:0] wr_addr,   // R0=00, R1=01, R2=10, R3=11
    input      [7:0] wr_data,
    // 讀取 port A（Rd / operand1）
    input      [1:0] rd_addrA,
    output     [7:0] rd_dataA,
    // 讀取 port B（Rs / operand2）
    input      [1:0] rd_addrB,
    output     [7:0] rd_dataB
);

    reg [7:0] regs [0:3];   // R0, R1, R2, R3

    // 同步寫入
    integer i;
    always @(posedge clk) begin
        if (rst) begin
            regs[0] &lt;= 8&apos;h00;
            regs[1] &lt;= 8&apos;h00;
            regs[2] &lt;= 8&apos;h00;
            regs[3] &lt;= 8&apos;h00;
        end else if (wr_en) begin
            regs[wr_addr] &lt;= wr_data;
        end
    end

    // 非同步讀取（combinational）
    assign rd_dataA = regs[rd_addrA];
    assign rd_dataB = regs[rd_addrB];

endmodule</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>rd_dataA:8,rd_dataB:8</string>
        </entry>
