        <entry>
          <string>Code</string>
          <string>// =================================================================
// alu.v  —  8-bit ALU for Dual-Core CPU
//
// ISA opcodes (4-bit):
//   0000  MOV  : Result = Operand2 (immediate passthrough)
//   0001  ADD  : Result = Op1 + Op2
//   0010  SUB  : Result = Op1 - Op2
//   0011  AND  : Result = Op1 &amp; Op2
//   0100  OR   : Result = Op1 | Op2
//   0101  OUT  : Result = Op2 (pixel color passthrough → VRAM)
//   0110  BEQ  : Result = Op1 (branch決定由control unit看flagZ)
//   0111  JMP  : Result = Op2 (target addr passthrough)
//
// flagZ : Result == 0  (BEQ 用)
// flagC : carry out    (備用，可接七段顯示)
// =================================================================

module alu (
    input  [3:0] opcode,
    input  [7:0] operand1,   // Rs (source register value)
    input  [7:0] operand2,   // Rd or immediate
    output reg [7:0] result,
    output reg flagZ,
    output reg flagC
);

    // ----------------------------------------------------------
    // Opcode parameters (與 control_unit.v 共用，建議未來改成
    // `include &quot;isa_def.vh&quot;，這裡先用 localparam 定義清楚)
    // ----------------------------------------------------------
    localparam [3:0]
        OP_MOV = 4&apos;b0000,
        OP_ADD = 4&apos;b0001,
        OP_SUB = 4&apos;b0010,
        OP_AND = 4&apos;b0011,
        OP_OR  = 4&apos;b0100,
        OP_OUT = 4&apos;b0101,   // 畫像素：把 operand2 (顏色) 直接輸出
        OP_BEQ = 4&apos;b0110,   // branch if zero：ALU 只做 pass，PC 由 CU 控制
        OP_JMP = 4&apos;b0111;   // jump：ALU pass target，CU 接手

    // ----------------------------------------------------------
    // 9-bit 暫存：[8] 存 carry，[7:0] 存結果
    // （參考作業寫法：用更寬的暫存截取進位）
    // ----------------------------------------------------------
    reg [8:0] tmp;

    always @(*) begin
        // 預設值（避免 latch）
        tmp   = 9&apos;b0;
        flagC = 1&apos;b0;
        flagZ = 1&apos;b0;

        case (opcode)

            // --------------------------------------------------
            // MOV Rd, imm  →  Rd ← imm（operand2 是 immediate）
            // --------------------------------------------------
            OP_MOV: begin
                tmp   = {1&apos;b0, operand2};
                flagC = 1&apos;b0;
            end

            // --------------------------------------------------
            // ADD Rd, Rs  →  Rd ← Rd + Rs
            // --------------------------------------------------
            OP_ADD: begin
                tmp   = {1&apos;b0, operand1} + {1&apos;b0, operand2};
                flagC = tmp[8];              // 與作業相同：bit[8] 當 carry
            end

            // --------------------------------------------------
            // SUB Rd, Rs  →  Rd ← Rd - Rs
            // --------------------------------------------------
            OP_SUB: begin
                tmp   = {1&apos;b0, operand1} - {1&apos;b0, operand2};
                flagC = tmp[8];              // borrow flag（同作業 SUB 處理）
            end

            // --------------------------------------------------
            // AND Rd, Rs  →  Rd ← Rd &amp; Rs
            // --------------------------------------------------
            OP_AND: begin
                tmp   = {1&apos;b0, operand1 &amp; operand2};
                flagC = 1&apos;b0;               // 邏輯運算不影響 carry（同作業）
            end

            // --------------------------------------------------
            // OR Rd, Rs  →  Rd ← Rd | Rs
            // --------------------------------------------------
            OP_OR: begin
                tmp   = {1&apos;b0, operand1 | operand2};
                flagC = 1&apos;b0;
            end

            // --------------------------------------------------
            // OUT addr, Rs  →  把 Rs 的 RGB 值輸出（pass-through）
            // ALU 只負責把 operand1（Rs 的顏色值）傳遞出去
            // control_unit 負責把 result 寫入 VRAM
            // --------------------------------------------------
            OP_OUT: begin
                tmp   = {1&apos;b0, operand1};   // operand1 = Rs (pixel color)
                flagC = 1&apos;b0;
            end

            // --------------------------------------------------
            // BEQ Rs, imm  →  if Rs == 0: PC ← imm
            // ALU 傳出 Rs 的值讓 CU 檢查 flagZ；
            // target address 另由指令 immediate 欄位提供
            // --------------------------------------------------
            OP_BEQ: begin
                tmp   = {1&apos;b0, operand1};   // operand1 = Rs（讓 flagZ 反映是否為 0）
                flagC = 1&apos;b0;
            end

            // --------------------------------------------------
            // JMP imm  →  PC ← imm（無條件跳轉）
            // ALU 傳遞 target（operand2），CU 直接載入 PC
            // --------------------------------------------------
            OP_JMP: begin
                tmp   = {1&apos;b0, operand2};   // operand2 = immediate target
                flagC = 1&apos;b0;
            end

            // --------------------------------------------------
            // Default：輸出 0，旗標清零
            // --------------------------------------------------
            default: begin
                tmp   = 9&apos;b0;
                flagC = 1&apos;b0;
            end

        endcase

        // flagZ：result[7:0] 全為 0 時拉高（同作業邏輯，但改成 8-bit 判斷）
        result = tmp[7:0];
        flagZ  = (result == 8&apos;h00);
    end

endmodule</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>result:8,flagZ,flagC</string>
        </entry>
