<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes/>
  <visualElements>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>IVERILOG</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>vga_sync</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>clk</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module vga_sync(
    input clk,
    output hsync,
    output vsync,
    output video_on,
    output [9:0] hcount,
    output [9:0] vcount
);

    parameter H_DISPLAY = 640;
    parameter H_FRONT   = 16;
    parameter H_SYNC    = 96;
    parameter H_BACK    = 48;
    parameter H_TOTAL   = 800;

    parameter V_DISPLAY = 480;
    parameter V_FRONT   = 10;
    parameter V_SYNC    = 2;
    parameter V_BACK    = 33;
    parameter V_TOTAL   = 525;

    // 計數器用reg
    reg [9:0] h_cnt = 0;
    reg [9:0] v_cnt = 0;

    // 水平計數器
    always @(posedge clk) begin
        if (h_cnt == H_TOTAL - 1)
            h_cnt &lt;= 0;
        else
            h_cnt &lt;= h_cnt + 1;
    end

    // 垂直計數器
    always @(posedge clk) begin
        if (h_cnt == H_TOTAL - 1) begin
            if (v_cnt == V_TOTAL - 1)
                v_cnt &lt;= 0;
            else
                v_cnt &lt;= v_cnt + 1;
        end
    end

    // 組合邏輯輸出
    assign hcount   = h_cnt;
    assign vcount   = v_cnt;
    assign hsync    = ~((h_cnt &gt;= H_DISPLAY + H_FRONT) &amp;&amp;
                        (h_cnt &lt;  H_DISPLAY + H_FRONT + H_SYNC));
    assign vsync    = ~((v_cnt &gt;= V_DISPLAY + V_FRONT) &amp;&amp;
                        (v_cnt &lt;  V_DISPLAY + V_FRONT + V_SYNC));
    assign video_on = (h_cnt &lt; H_DISPLAY) &amp;&amp; (v_cnt &lt; V_DISPLAY);

endmodule</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>hsync,vsync,video_on,hcount:10,vcount:10</string>
        </entry>
        <entry>
          <string>Width</string>
          <int>6</int>
        </entry>
