        <entry>
          <string>Code</string>
          <string>// =================================================================
// bus_arbiter.v  —  Round-Robin Bus Arbiter
//
// 兩個 core 競爭 VRAM 寫入權
// 策略：round-robin，誰先請求就先給，平手時交替
// gnt 只在 req 有效時拉高，且一次只給一個
// =================================================================

module bus_arbiter (
    input  clk,
    input  rst,

    // Core 0
    input  req0,
    output reg gnt0,

    // Core 1
    input  req1,
    output reg gnt1
);

    reg last_gnt;   // 0 = 上次給 core0，1 = 上次給 core1

    always @(posedge clk) begin
        if (rst) begin
            gnt0     &lt;= 1&apos;b0;
            gnt1     &lt;= 1&apos;b0;
            last_gnt &lt;= 1&apos;b0;
        end else begin
            gnt0 &lt;= 1&apos;b0;
            gnt1 &lt;= 1&apos;b0;

            if (req0 &amp;&amp; req1) begin
                // 雙方同時請求 → 輪流
                if (last_gnt == 1&apos;b0) begin
                    gnt1     &lt;= 1&apos;b1;
                    last_gnt &lt;= 1&apos;b1;
                end else begin
                    gnt0     &lt;= 1&apos;b1;
                    last_gnt &lt;= 1&apos;b0;
                end
            end else if (req0) begin
                gnt0     &lt;= 1&apos;b1;
                last_gnt &lt;= 1&apos;b0;
            end else if (req1) begin
                gnt1     &lt;= 1&apos;b1;
                last_gnt &lt;= 1&apos;b1;
            end
        end
    end

endmodule</string>
