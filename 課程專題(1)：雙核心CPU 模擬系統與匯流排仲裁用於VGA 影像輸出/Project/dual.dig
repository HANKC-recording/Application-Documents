        <entry>
          <string>Code</string>
          <string>// =================================================================
// pixel_driver.v  —  VGA 640×480 版（16×16 VRAM 放大顯示）
//
// 16×16 VRAM 放大到 640×480：
//   每個像素放大成 40×30 個 VGA 像素
//   hcount / 40 = vram_x (0~15)
//   vcount / 30 = vram_y (0~15)
//   vram_addr   = vram_y * 16 + vram_x (0~255)
// =================================================================
module pixel_driver (
    input        clk,
    input        rst,
    // 來自 vga_sync（640×480）
    input  [9:0] hcount,
    input  [9:0] vcount,
    input        video_on,
    // VRAM 讀取介面
    output [7:0] vram_rd_addr,
    input  [2:0] vram_rd_data,   // [2]=R [1]=G [0]=B
    // VGA RGB 輸出（1-bit each）
    output R,
    output G,
    output B
);
    // 用查找表做除法（避免模擬器不支援除法運算子）
    // hcount 0~639  / 40 → 0~15
    // vcount 0~479  / 30 → 0~15
    reg [3:0] hmap [0:639];
    reg [3:0] vmap [0:479];
    integer i;
    initial begin
        for (i = 0; i &lt; 640; i = i + 1)
            hmap[i] = i / 40;
        for (i = 0; i &lt; 480; i = i + 1)
            vmap[i] = i / 30;
    end

    wire [3:0] px = hmap[hcount];
    wire [3:0] py = vmap[vcount];

    // VRAM 位址 = py * 16 + px
    assign vram_rd_addr = {py, px};

    // RGB 輸出
    assign R = video_on ? vram_rd_data[2] : 1&apos;b0;
    assign G = video_on ? vram_rd_data[1] : 1&apos;b0;
    assign B = video_on ? vram_rd_data[0] : 1&apos;b0;
endmodule</string>
