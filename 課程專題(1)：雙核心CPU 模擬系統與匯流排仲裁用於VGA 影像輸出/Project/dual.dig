        <entry>
          <string>Code</string>
          <string>// =================================================================
// vram.v  —  Shared VRAM  256 × 3-bit（16×16 像素）
//
// addr 0~127   → Core 0（row 0~7）
// addr 128~255 → Core 1（row 8~15）
// =================================================================

module vram (
    input        clk,
    input        wr_en0,
    input  [7:0] wr_addr0,
    input  [2:0] wr_data0,
    input        wr_en1,
    input  [7:0] wr_addr1,
    input  [2:0] wr_data1,
    input  [7:0] rd_addr,
    output [2:0] rd_data
);
    reg [2:0] mem [0:255];

    always @(posedge clk) begin
        if (wr_en0) mem[wr_addr0] &lt;= wr_data0;
        if (wr_en1) mem[wr_addr1] &lt;= wr_data1;
    end

    assign rd_data = mem[rd_addr];
endmodule</string>
