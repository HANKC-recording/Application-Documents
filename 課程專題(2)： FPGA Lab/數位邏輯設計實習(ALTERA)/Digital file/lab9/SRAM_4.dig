        <entry>
          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;

entity CtrSRAM_2 is
    port (
        clk  : in  std_logic;
        rst  : in  std_logic;
        sel1 : out std_logic;
        en1  : out std_logic;
        sel2 : out std_logic;
        en2  : out std_logic;
        Addr : out std_logic_vector(1 downto 0);
        CS   : out std_logic;
        WE   : out std_logic;
        OE   : out std_logic
    );
end CtrSRAM_2;

architecture Hybrid of CtrSRAM_2 is
    signal Q : std_logic_vector(2 downto 0) := &quot;000&quot;; 
    signal D : std_logic_vector(2 downto 0);
    
    -- 宣告一個 9-bit 的信號，用來當作所有輸出控制線的「總表」
    -- 排列順序：sel1(8), en1(7), sel2(6), en2(5), Addr(4 downto 3), CS(2), WE(1), OE(0)
    signal Ctrl_Bus : std_logic_vector(8 downto 0);

begin

    -- ==========================================
    -- 1. 次態邏輯 (嚴格使用 D 的布林代數式)
    -- ==========================================
    D(2) &lt;= Q(2) or (Q(1) and Q(0));
    D(1) &lt;= (not Q(2) and not Q(1) and Q(0)) or (Q(1) and not Q(0));
    D(0) &lt;= Q(2) or not Q(0);

    -- ==========================================
    -- 2. 狀態暫存器 (D 正反器)
    -- ==========================================
    process(clk)
    begin
        if rising_edge(clk) then
            if rst = &apos;1&apos; then
                Q &lt;= &quot;000&quot;; 
            else
                Q &lt;= D;     
            end if;
        end if;
    end process;

    -- ==========================================
    -- 3. 輸出邏輯 (直接寫成一張真值表 Lookup Table)
    -- ==========================================
    -- 利用 with ... select 語法，根據當前狀態 Q，直接賦值給 Ctrl_Bus
    -- 排列順序: sel1 &amp; en1 &amp; sel2 &amp; en2 &amp; Addr(2 bits) &amp; CS &amp; WE &amp; OE
    with Q select
        Ctrl_Bus &lt;=
            -- sel1, en1, sel2, en2, Addr1, Addr0, CS, WE, OE
            &quot;000000000&quot; when &quot;000&quot;, -- S0
            &quot;000000110&quot; when &quot;001&quot;, -- S1
            &quot;000001110&quot; when &quot;010&quot;, -- S2
            &quot;010000101&quot; when &quot;011&quot;, -- S3
            &quot;101101101&quot; when &quot;100&quot;, -- S4
            &quot;101101111&quot; when &quot;101&quot;, -- S5
            &quot;000000000&quot; when others;-- 未使用狀態 S6, S7 預設輸出 0

    -- ==========================================
    -- 4. 將總表的數值解開，接給實際的輸出腳位
    -- ==========================================
    sel1 &lt;= Ctrl_Bus(8);
    en1  &lt;= Ctrl_Bus(7);
    sel2 &lt;= Ctrl_Bus(6);
    en2  &lt;= Ctrl_Bus(5);
    Addr &lt;= Ctrl_Bus(4 downto 3);
    CS   &lt;= Ctrl_Bus(2);
    WE   &lt;= Ctrl_Bus(1);
    OE   &lt;= Ctrl_Bus(0);

end Hybrid;</string>
