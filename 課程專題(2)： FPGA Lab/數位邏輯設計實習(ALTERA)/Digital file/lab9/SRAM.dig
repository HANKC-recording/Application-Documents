        <entry>
          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

entity SRAM is
port (	
    D: in std_logic_vector(3 downto 0);      -- 資料輸入
    Address: in std_logic_vector(1 downto 0); -- 改為 2-bit 以定址 4 組 (00, 01, 10, 11)
    ChipSelect, WE, OE: in std_logic;
    DO: out std_logic_vector(3 downto 0)     -- 資料輸出
);
end SRAM;

architecture SRAM_simple of SRAM is

    -- 定義記憶體：4 個元素，每個元素是 4 位元的向量
    type memory is array (0 to 3) of std_logic_vector(3 downto 0);
    signal SRAM_internal: memory := (others =&gt; &quot;0000&quot;);

begin

    -- 寫入邏輯：當 CS=1 且 WE=1 時寫入
    process(ChipSelect, WE, Address, D)
    begin
        if (ChipSelect = &apos;1&apos; and WE = &apos;1&apos;) then
            SRAM_internal(to_integer(unsigned(Address))) &lt;= D;
        end if;
    end process;

    -- 讀取邏輯：當 CS=1, OE=1 且 WE=0 時輸出資料，其餘狀態輸出高阻抗 (Hi-Z)
    DO &lt;= SRAM_internal(to_integer(unsigned(Address))) 
          when (ChipSelect = &apos;1&apos; and OE = &apos;1&apos; and WE = &apos;0&apos;) 
          else &quot;ZZZZ&quot;;

end SRAM_simple;</string>
        </entry>
