        <entry>
          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;

entity CtrSRAM is
    port (
        clk  : in  std_logic;
        rst  : in  std_logic;
        sel1 : out std_logic;
        en1  : out std_logic;
        sel2 : out std_logic;
        en2  : out std_logic;
        Addr : out std_logic_vector(1 downto 0);
        CS   : out std_logic;
        WE   : out std_logic;
        OE   : out std_logic
    );
end CtrSRAM;

architecture CtrSRAM_arch of CtrSRAM is
    type state_type is (S0, S1, S2, S3, S4, S5);
    signal current_state, next_state : state_type;
begin

    -- ==========================================
    -- 狀態暫存器（同步 reset）
    -- ==========================================
    process(clk)
    begin
        if rising_edge(clk) then
            if rst = &apos;1&apos; then
                current_state &lt;= S0;   -- 同步 reset 回 S0
            else
                current_state &lt;= next_state;
            end if;
        end if;
    end process;

    -- ==========================================
    -- 次態邏輯（rst 加入敏感列，S0 等 rst 放開）
    -- ==========================================
    process(current_state, rst)
    begin
        case current_state is
            when S0 =&gt;
                if rst = &apos;1&apos; then
                    next_state &lt;= S0;   -- rst 期間鎖在 S0
                else
                    next_state &lt;= S1;   -- rst 放開才往前
                end if;
            when S1 =&gt; next_state &lt;= S2;
            when S2 =&gt; next_state &lt;= S3;
            when S3 =&gt; next_state &lt;= S4;
            when S4 =&gt; next_state &lt;= S5;
            when S5 =&gt; next_state &lt;= S5;
            when others =&gt; next_state &lt;= S0;
        end case;
    end process;

    -- ==========================================
    -- 輸出邏輯（Moore）
    -- ==========================================
    process(current_state)
    begin
        sel1 &lt;= &apos;0&apos;; en1 &lt;= &apos;0&apos;; sel2 &lt;= &apos;0&apos;; en2 &lt;= &apos;0&apos;;
        Addr &lt;= &quot;00&quot;; CS &lt;= &apos;0&apos;; WE &lt;= &apos;0&apos;; OE &lt;= &apos;0&apos;;

        case current_state is
            when S0 =&gt;
                sel1 &lt;= &apos;0&apos;; en1 &lt;= &apos;0&apos;; sel2 &lt;= &apos;0&apos;; en2 &lt;= &apos;0&apos;;
                Addr &lt;= &quot;00&quot;; CS &lt;= &apos;0&apos;; WE &lt;= &apos;0&apos;; OE &lt;= &apos;0&apos;;
            when S1 =&gt;
                sel1 &lt;= &apos;0&apos;; en1 &lt;= &apos;0&apos;; sel2 &lt;= &apos;0&apos;; en2 &lt;= &apos;0&apos;;
                Addr &lt;= &quot;00&quot;; CS &lt;= &apos;1&apos;; WE &lt;= &apos;1&apos;; OE &lt;= &apos;0&apos;;
            when S2 =&gt;
                sel1 &lt;= &apos;0&apos;; en1 &lt;= &apos;0&apos;; sel2 &lt;= &apos;0&apos;; en2 &lt;= &apos;0&apos;;
                Addr &lt;= &quot;01&quot;; CS &lt;= &apos;1&apos;; WE &lt;= &apos;1&apos;; OE &lt;= &apos;0&apos;;
            when S3 =&gt;
                sel1 &lt;= &apos;0&apos;; en1 &lt;= &apos;1&apos;; sel2 &lt;= &apos;0&apos;; en2 &lt;= &apos;0&apos;;
                Addr &lt;= &quot;00&quot;; CS &lt;= &apos;1&apos;; WE &lt;= &apos;0&apos;; OE &lt;= &apos;1&apos;;
            when S4 =&gt;
                sel1 &lt;= &apos;1&apos;; en1 &lt;= &apos;0&apos;; sel2 &lt;= &apos;1&apos;; en2 &lt;= &apos;1&apos;;
                Addr &lt;= &quot;01&quot;; CS &lt;= &apos;1&apos;; WE &lt;= &apos;0&apos;; OE &lt;= &apos;1&apos;;
            when S5 =&gt;
                sel1 &lt;= &apos;1&apos;; en1 &lt;= &apos;0&apos;; sel2 &lt;= &apos;1&apos;; en2 &lt;= &apos;1&apos;;
                Addr &lt;= &quot;01&quot;; CS &lt;= &apos;1&apos;; WE &lt;= &apos;1&apos;; OE &lt;= &apos;1&apos;;
            when others =&gt;
                null;
        end case;
    end process;

end CtrSRAM_arch;</string>
