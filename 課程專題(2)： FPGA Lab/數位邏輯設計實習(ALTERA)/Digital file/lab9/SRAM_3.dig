          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

entity SRAM is
port (	
    D: in std_logic_vector(3 downto 0);
    Address: in std_logic_vector(1 downto 0);
    ChipSelect, WE, OE: in std_logic;
    DO: out std_logic_vector(3 downto 0)
);
end SRAM;

architecture SRAM_simple of SRAM is
    type memory is array (0 to 3) of std_logic_vector(3 downto 0);
    signal SRAM_internal: memory := (others =&gt; &quot;0000&quot;);
begin
    -- 寫入邏輯：CS=1 且 WE=1 時寫入（不管 OE 狀態）
    process(ChipSelect, WE, Address, D)
    begin
        if (ChipSelect = &apos;1&apos; and WE = &apos;1&apos;) then
            SRAM_internal(to_integer(unsigned(Address))) &lt;= D;
        end if;
    end process;

    -- 讀取邏輯：CS=1 且 OE=1 時輸出（WE=1 同時寫入也能讀出，即 write-through）
    DO &lt;= SRAM_internal(to_integer(unsigned(Address)))
          when (ChipSelect = &apos;1&apos; and OE = &apos;1&apos;)
          else &quot;ZZZZ&quot;;
end SRAM_simple;</string>
        </entry>
