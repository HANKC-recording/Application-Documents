        <entry>
          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

entity SRFF is
port (S, R, CLK: in std_logic;
      Q, QN: out std_logic);	
end SRFF;

architecture SRFF1 of SRFF is
signal Qint: std_logic:=&apos;0&apos;;

begin
	Q &lt;= Qint;	-- output Q and QN to port
	QN &lt;= not Qint;	
	process (CLK)	
	begin
		if CLK&apos;event and CLK = &apos;1&apos; then
			if S=&apos;0&apos; and R=&apos;0&apos; then  Qint &lt;= Qint;
			elsif S=&apos;1&apos; and R=&apos;0&apos; then  Qint &lt;= &apos;1&apos;; 
			elsif S=&apos;0&apos; and R=&apos;1&apos; then  Qint &lt;= &apos;0&apos;;  
			end if;
		end if;
	 end process;
end SRFF1;</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>Q,QN</string>
        </entry>
        <entry>
          <string>Code_File</string>
