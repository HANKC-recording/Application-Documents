<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>2</version>
  <attributes/>
  <visualElements>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>GHDL</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>bcd_detector</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>clk,X</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>-- ============================================================
-- 作業一：BCD 有效碼偵測器（Mealy 狀態機）
-- 設計方式：布林代數式（Boolean Algebra Expression）- 無 Reset 版
-- 學校：國立台北科技大學 電機工程系
-- ============================================================
-- (功能說明與狀態編碼保留原樣，略過以保持版面簡潔，見原程式碼)
-- ============================================================

library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity bcd_detector is
    Port (
        clk       : in  STD_LOGIC;                      -- 系統時脈 (Clock)
        X         : in  STD_LOGIC;                      -- 1-bit 序列輸入，每次接收 1 個 bit（MSB 先進）
        Z         : out STD_LOGIC;                      -- 1-bit 輸出：當偵測到合法 BCD 碼時，Z 輸出 1
        state_out : out STD_LOGIC_VECTOR(2 downto 0)    -- 3-bit 輸出：用來在模擬波形圖上觀察目前的內部狀態 (A, B, C)
    );
end bcd_detector;

architecture boolean_arch of bcd_detector is

    -- 【現態暫存器】
    -- 宣告 3 個 D 型正反器 (Flip-Flop) 的輸出端 A, B, C
    -- 這裡特別給定初始值 &apos;:=&apos;0&apos;&apos;，當 FPGA 上電 (Power-on) 或模擬開始時，狀態會自動初始化為 S0 (000)。
    -- 這個技巧讓我們可以省去一個實體的 Reset 接腳。
    signal A, B, C : STD_LOGIC := &apos;0&apos;;

    -- 【次態訊號】
    -- 宣告 3 個 D 型正反器的輸入端 DA, DB, DC
    -- 這些訊號會由下方的「組合邏輯電路」計算出來，準備在下一個 Clock 觸發時寫入 A, B, C
    signal DA, DB, DC : STD_LOGIC;

begin

    -- ========================================================
    -- 第一部分：【次態邏輯】 (組合邏輯電路 Combinational Logic)
    -- 根據「目前的狀態 (A, B, C)」與「當前的輸入 (X)」來決定下一個狀態
    -- 這裡直接將卡諾圖化簡後的布林代數式轉換為 VHDL 邏輯閘語法
    -- ========================================================

    -- 計算 DA (下一個時脈的 A 值)
    -- 對應公式: DA = A&apos;B + AB&apos; (其實就是 A XOR B)
    DA &lt;= (not A and B) or (A and not B);

    -- 計算 DB (下一個時脈的 B 值)
    -- 對應公式: DB = AB&apos; + A&apos;C + A&apos;B&apos;X
    DB &lt;= (A and not B)
       or (not A and C)
       or (not A and not B and X);

    -- 計算 DC (下一個時脈的 C 值)
    -- 對應公式: DC = B&apos;C + A&apos;B&apos;X&apos; + AB&apos;X + A&apos;BC&apos;X
    DC &lt;= (not B and C)
       or (not A and not B and not X)
       or (A and not B and X)
       or (not A and B and not C and X);

    -- ========================================================
    -- 第二部分：【輸出邏輯】 (組合邏輯電路 Combinational Logic)
    -- ========================================================
    
    -- Mealy Machine 的特徵是：輸出會受到「現態」與「輸入」的影響。
    -- 根據你的設計，只有當狀態進入 S6 (A=1, B=1, C=0) 時，Z 才會輸出 1。
    Z &lt;= A and B and not C;

    -- 將內部的現態訊號 (A, B, C) 使用 &apos;&amp;&apos; (串接運算子) 打包成 3-bit 向量，
    -- 直接推送到實體輸出接腳 state_out 上，方便 Debug 與觀察狀態機的跳轉過程。
    state_out &lt;= A &amp; B &amp; C;

    -- ========================================================
    -- 第三部分：【狀態暫存器】 (循序邏輯電路 Sequential Logic)
    -- 負責在 Clock 邊緣更新狀態
    -- ========================================================
    process(clk)
    begin
        -- 當偵測到 clk 的正緣 (Rising Edge) 時，執行以下動作：
        if rising_edge(clk) then
            -- 將組合電路算好的「次態 (DA, DB, DC)」正式寫入「現態 (A, B, C)」
            -- 完成一次狀態轉換 (State Transition)
            A &lt;= DA;
            B &lt;= DB;
            C &lt;= DC;
        end if;
    end process;

end boolean_arch;</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>Z,state_out:3</string>
        </entry>
        <entry>
          <string>Width</string>
          <int>6</int>
        </entry>
